# Copy to .env (never commit .env). Use an implementation or sandbox tenant first.
# SOAP goes to the services host, not the UI host (impl.wd12.myworkday.com).
WD_SERVICES_HOST=impl-services1.wd12.myworkday.com
WD_TENANT=your_tenant_id
WD_ISU_USERNAME=your_isu_name
WD_ISU_PASSWORD=your_isu_password
WD_WWS_VERSION=v47.0
# How --bp names the business process. Confirm on the first live run.
WD_BP_TYPE_ID_TYPE=Business_Process_Type
# Optional: build the client from a local WSDL file instead of fetching it
# WD_WSDL=
